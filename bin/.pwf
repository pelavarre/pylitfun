# sh/.pwf = Print the Pwf, but first show its 'ls -l' and Scp Spec, and create it when missing

# shellcheck shell=bash  # SC1071: 2026-09 ShellCheck doesn't check shell=zsh
# shellcheck disable=SC2012  # Use find instead of ls to better handle non-alphanumeric filenames.

set -e

P=$(find . -maxdepth 1 -not -type d -print0 |xargs -0 -r ls -rt |tail -1 |sed 's,^[.]/,,')
if [ ! "$P" ]; then
    P=t.txt
    touch "$P"
fi

SSH=$(id -un)@$(hostname)
CD=$(dirs -p |head -1 |sed 's,/*$,/,')
DOLLAR='$'

printf '%s\n' $DOLLAR'(find -not d ... ls -rt |tail ... ls -hlAF ... id -un ... dirs -p ...)' >&2
ls -d -hlAF -rt "$@" "$P" |column -t >&2
printf '%s\n' "$SSH:$CD$P" >&2

printf '%s\n' "./$P"
