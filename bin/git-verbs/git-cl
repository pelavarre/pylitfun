#!/bin/sh

if [ $# = 1 ] && [ "$1" = "-n" ]; then

    echo ': gcl && git clean -dffxn' >&2
    git clean -dffxn

else

    echo ': gcl && echo Press ⌃D && cat - >/dev/null && git clean -dffxq' >&2
    echo 'Press ⌃D to auth:  git clean -dffxq' "$@" >&2
    cat - >/dev/null
    : gcl && git clean -dffxq "$@"

fi
