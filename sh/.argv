# sh/.argv = show each of the Shell sys.argv[1:] as one accurate line of Py Repr = sh/.echo

echo "+ python3 -c ''' ..." >&2

python3 -c '''

import sys

for (i, a) in enumerate(sys.argv[1:]):
    print(f"{i + 1}: {a!r}")  # 1: "Hello, ArgV World!"

if not sys.argv[1:]:
    print(len(sys.argv[1:]))  # "0"

''' "$@"

# could be coded as '#!/usr/bin/env python3', and isn't
