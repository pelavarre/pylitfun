# sh/.ssh = Call Ssh but without Profile

if [ $# -eq 0 ]; then  # logs in nearby

    set -xe
    ssh -A -t -F /dev/null \
        -o 'UserKnownHostsFile /dev/null' \
        -o 'StrictHostKeyChecking no' \
        -o 'LogLevel QUIET' "$USER@localhost"

elif [[ "$1" =~ @ ]]; then  # logs in as jqdoe@example.com, etc

    set -xe
    ssh -A -t -F /dev/null \
        -o 'UserKnownHostsFile /dev/null' \
        -o 'StrictHostKeyChecking no' \
        -o 'LogLevel QUIET' "$@"

else  # logs in as $USER@...

    set -xe
    ssh -A -t -F /dev/null \
        -o 'UserKnownHostsFile /dev/null' \
        -o 'StrictHostKeyChecking no' \
        -o 'LogLevel QUIET' "$USER@$@"

fi
