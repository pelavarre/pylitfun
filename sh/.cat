# sh/.cat = Prompt to take & drop input, or do what you're told, or do nothing loudly = aka sh/_

if [ $# -ne 0 ]; then  # .cat ...  # with args

    set -xe
    cat "$@"

elif [ -t 0 ]; then

    echo 'Press ⌃D to quit happy, or ⌃C to quit sad' >&2
    if [ -t 1 ]; then  # .cat  # standalone
        set -xe
        echo 'cat - >/dev/null' >&2
        cat - >/dev/null
    else  # .cat |...  # at the front
        set -xe
        cat -
    fi

else  # |.cat  # |.cat |...  # at the back or in the middle

    set -xe
    cat -

fi
