# sh/.mv = Put a date-time stamp on an original File or Folder so that it looks deleted

if [ $# = 0 ]; then
    P=$(find . -maxdepth 1 -not -type d -print0 |xargs -0 -r ls -rt |tail -1)
    if [ "$P" ]; then
       set "$P"
    fi
fi

F=$(echo "$@") && echo + mv -i $F{,~$(date -r $F +%m%djqd%H%M)~} |tee /dev/tty |sed 's,^+ ,,' |sh
