# sh/.pwd = Print the Pwd and prefer relative to ~/, but first show its 'ls -dl' and Scp Spec

# shellcheck shell=bash  # SC1071: 2026-09 ShellCheck doesn't check shell=zsh
# shellcheck disable=SC2012  # Use find instead of ls to better handle non-alphanumeric filenames.

set -e

SSH=$(id -un)@$(hostname)
CD=$(dirs -p |head -1 |sed 's,/*$,/,')
DOLLAR='$'

printf '%s\n' $DOLLAR'(dirs -p ... head ... ls -d -hlAF -rt ... id -un ... hostname)' >&2
ls -d -hlAF -rt "$@" "$PWD" |sed "s,$HOME/,~/," |column -t >&2
printf '%s\n' "$SSH:$CD" >&2

printf '%s\n' "$CD"
