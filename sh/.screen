# sh/.screen = reconnect via 'screen -rr', else launch a low-latency log of a new labelled chat

if [ $# -eq 0 ]; then

    set -xe
    screen -rr

else

    T=$1
    shift

    set -xe
    echo "logfile $T.screen" >$T.cfg
    echo "logfile flush 0" >>$T.cfg
    T=$T screen -S $T -L -c $T.cfg "$@"

fi
